PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call the API (e.g. https://lifegym-uralsk.kz).
# Leave empty if the frontend is served by this same server (recommended, avoids CORS entirely).
ALLOWED_ORIGINS=

# Telegram notifications for new leads.
# 1. Message @BotFather on Telegram, /newbot, copy the token below.
# 2. Add the bot to the chat/group/channel that should receive leads, send it any message.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and read the numeric "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required to read/manage leads via GET/PATCH /api/leads and the /admin page.
# Generate one long random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-string

# Path (relative to backend/) to the static site to serve (index.html, css/, js/, images/).
# Default ".." serves the repo root, i.e. this backend + the existing frontend on one origin/port.
# Leave empty to run the API only (e.g. if the frontend is hosted elsewhere, like Netlify/Vercel).
STATIC_SITE_DIR=..
